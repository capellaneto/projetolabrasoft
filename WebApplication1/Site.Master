<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebApplication1.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Sistema de Bolsistas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header>
            <h1>Gestão de Bolsistas</h1>
            <hr />
        </header>

        <nav style="background: #eee; padding: 10px; margin-bottom: 20px;">

            <asp:Panel ID="menuNavegacao" runat="server">

           <asp:HyperLink 
               ID="lnkInicio" 
               runat="server" 
               NavigateUrl="BolsistaExemplo.aspx" 
               Text="Início (Teste)"> 
           </asp:HyperLink> | 


            <asp:HyperLink 
                ID="lnkBolsistas" 
                runat="server" 
                NavigateUrl="CadastroBolsista.aspx" 
                Text="Bolsistas"> 
            </asp:HyperLink> |


             <asp:HyperLink 
                 ID="lnkCoordenadores" 
                 runat="server" 
                 NavigateUrl="CadastroCoordenador.aspx" 
                 Text="Coordenadores"> 
             </asp:HyperLink> |
            
                
                <asp:HyperLink 
                 ID="lnkProjetos" 
                 runat="server" 
                 NavigateUrl="CadastroProjeto.aspx" 
                 Text="Projetos"> 
             </asp:HyperLink> |


             <asp:HyperLink 
                 ID="lnkDespesas"
                 runat="server"
                 NavigateUrl="Despesa.aspx"
                 Text="Despesas">
             </asp:HyperLink> 

            </asp:Panel>
        </nav>


        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
