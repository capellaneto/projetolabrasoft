<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="Conexao" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=labrasoftT2;Integrated Security=True" providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.8"/>
